# Smoke simulator ONLY — copy to .env.local for manual UI review with payout-smoke-simulator.
# For real backends use .env.live.example instead (see README in payout-smoke-simulator).
# Start simulator: cd ../payout-smoke-simulator && docker compose up -d
#
# AWS: set these same keys in the console task/env. Replace localhost:8099 with the
# smoke service URL. For real microservices, use .env.live.example instead (not both).

SMOKE_SIMULATOR_URL=http://localhost:8099

ZORD_EDGE_URL=http://localhost:8099
ZORD_INTENT_ENGINE_URL=http://localhost:8099
ZORD_SETTLEMENT_URL=http://localhost:8099
ZORD_INTELLIGENCE_URL=http://localhost:8099
ZORD_EVIDENCE_URL=http://localhost:8099
ZORD_CONNECTORS_URL=http://localhost:8099
ZORD_RELAY_URL=http://localhost:8099
ZORD_VAULT_URL=http://localhost:8099
ZORD_CONTRACTS_URL=http://localhost:8099
ZORD_PII_ENCLAVE_URL=http://localhost:8099
PROMPT_LAYER_URL=http://localhost:8099

# Matches simulator default tenant + API key
NEXT_PUBLIC_ZORD_TENANT_ID=00000000-0000-0000-0000-000000000001
ZORD_SETTLEMENT_API_KEY=zord-local-dev-api-key
ZORD_BULK_INGEST_API_KEY=zord-local-dev-api-key

# Optional: "Book a demo" leads (POST /api/leads) → Slack Incoming Webhook.
# Leads still log to the server console + succeed if this is unset.
# SLACK_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Local dev cookies (http://localhost:3000)
AUTH_COOKIE_SECURE=false
