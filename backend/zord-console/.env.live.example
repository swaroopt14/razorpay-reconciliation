# Live backend services — copy to .env.local when using real microservices (NOT the smoke simulator).
# Defaults match local docker-compose ports per service README.
#
# AWS: set these same keys in the console task/env with each service’s real URL.
# Do not mix with .env.smoke.example (smoke points every ZORD_*_URL at one host).

ZORD_EDGE_URL=http://localhost:8080
ZORD_INTENT_ENGINE_URL=http://localhost:8083
ZORD_SETTLEMENT_URL=http://localhost:8081
ZORD_INTELLIGENCE_URL=http://localhost:8089
ZORD_EVIDENCE_URL=http://localhost:8088
ZORD_RELAY_URL=http://localhost:8082
ZORD_VAULT_URL=http://localhost:8081
ZORD_CONTRACTS_URL=http://localhost:8084
ZORD_PII_ENCLAVE_URL=http://localhost:8085
ZORD_CONNECTORS_URL=http://localhost:8080
PROMPT_LAYER_URL=http://localhost:8086

# Sign in via /signin — session tenant comes from zord-edge (do not hardcode unless debugging).
# NEXT_PUBLIC_ZORD_TENANT_ID=

# Optional: settlement upload / bulk ingest when no session cookie
# ZORD_SETTLEMENT_API_KEY=
# ZORD_BULK_INGEST_API_KEY=

# Optional: "Book a demo" leads (POST /api/leads) are posted to this Slack Incoming Webhook.
# Create one at https://api.slack.com/messaging/webhooks — leads still log + succeed if unset.
# SLACK_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: support tickets (POST /api/support/tickets, replies, manual review escalations).
# Use a separate Incoming Webhook channel from demo leads. Tickets still persist if unset.
# SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

AUTH_COOKIE_SECURE=false
