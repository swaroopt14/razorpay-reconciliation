# Docker Compose env for zord-console (Option B).
# Copy to backend/console/.env - Docker Compose reads this file automatically.
# Do NOT commit .env (gitignored). Share values privately with testers.
#
# Usage:
#   cd backend/console
#   cp env.docker-compose.example .env
#   # edit SLACK_* URLs, then:
#   docker compose up -d --build
#
# Inside the container, backends on the host must use host.docker.internal (not localhost).

AUTH_COOKIE_SECURE=false

# Slack Incoming Webhooks (separate channels recommended)
SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SLACK_LEADS_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Live microservices on host (default ports) ──────────────────────────────
ZORD_EDGE_URL=http://host.docker.internal:8080
ZORD_INTENT_ENGINE_URL=http://host.docker.internal:8083
ZORD_SETTLEMENT_URL=http://host.docker.internal:8081
ZORD_INTELLIGENCE_URL=http://host.docker.internal:8089
ZORD_EVIDENCE_URL=http://host.docker.internal:8088
ZORD_RELAY_URL=http://host.docker.internal:8082
ZORD_VAULT_URL=http://host.docker.internal:8081
ZORD_CONTRACTS_URL=http://host.docker.internal:8084
ZORD_PII_ENCLAVE_URL=http://host.docker.internal:8085
ZORD_CONNECTORS_URL=http://host.docker.internal:8080
# PROMPT_LAYER_URL is set in docker-compose.yml to zord-prompt-layer on the shared network.

# Optional API keys (if not using session-only auth)
# ZORD_SETTLEMENT_API_KEY=
# ZORD_BULK_INGEST_API_KEY=

# ── Smoke simulator on host (uncomment block below, comment live block above) ─
# ZORD_EDGE_URL=http://host.docker.internal:8099
# ZORD_INTENT_ENGINE_URL=http://host.docker.internal:8099
# ZORD_SETTLEMENT_URL=http://host.docker.internal:8099
# ZORD_INTELLIGENCE_URL=http://host.docker.internal:8099
# ZORD_EVIDENCE_URL=http://host.docker.internal:8099
# ZORD_RELAY_URL=http://host.docker.internal:8099
# ZORD_VAULT_URL=http://host.docker.internal:8099
# ZORD_CONTRACTS_URL=http://host.docker.internal:8099
# ZORD_PII_ENCLAVE_URL=http://host.docker.internal:8099
# ZORD_SETTLEMENT_API_KEY=zord-local-dev-api-key
# ZORD_BULK_INGEST_API_KEY=zord-local-dev-api-key
